# ============================================
# ConversaPay Site Builder - Environment Variables
# ============================================

# Application Settings
APP_NAME=ConversaPay Site Builder
APP_VERSION=1.0.0
DEBUG=False

# Gemini API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8001
RELOAD=True

# Logging
LOG_LEVEL=info

# CORS Origins (comma-separated for production)
CORS_ORIGINS=https://conversapay.org,https://www.conversapay.org,https://app.conversapay.org