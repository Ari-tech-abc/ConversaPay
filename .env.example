# ConversaPay environment
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
GEMINI_API_KEY=replace-with-gemini-key

# Cardcom v11 test environment
CARDCOM_TERMINAL_NUMBER=1000
CARDCOM_USER_NAME=Cardcomtest26
CARDCOM_BASE_URL=https://cardcom.solutions
CARDCOM_API_TOKEN=YOUR_TOKEN_HERE
CARDCOM_LOW_PROFILE_CREATE_PATH=/api/v11/LowProfile/Create
CARDCOM_LOW_PROFILE_GET_PATH=/api/v11/LowProfile/Get
CARDCOM_INDICATOR_URL=https://conversapay.org/api/v1/webhooks/cardcom
