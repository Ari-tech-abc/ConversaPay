CARDCOM_FAILURE_URL=https://conversapay.org/pay.html?status=failed
CARDCOM_CANCEL_URL=https://conversapay.org/pay.html?status=canceled
CARDCOM_TIMEOUT_SECONDS=30

RESEND_API_KEY=replace-with-resend-key
EMAIL_FROM_ADDRESS=no-reply@conversapay.org
